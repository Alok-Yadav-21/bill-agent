# ---------- Database (source of truth) ----------
DATABASE_URL="postgresql://user:password@localhost:5432/bill_agent?schema=public"

# ---------- Authentication ----------
# Wire src/lib/session.ts to your provider. Example (Supabase):
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server only, never exposed

# ---------- Receipt processing (OPTIONAL) ----------
# RECEIPT_PROCESSOR selects the implementation: n8n | anthropic | textract | ...
RECEIPT_PROCESSOR="n8n"
N8N_RECEIPT_WEBHOOK_URL="https://your-n8n-host/webhook/receipt-processing"
N8N_API_KEY="shared-secret-between-app-and-n8n"

# ---------- AI assistant (OPTIONAL) ----------
# AI_ASSISTANT selects the implementation: local | n8n | anthropic | ...
AI_ASSISTANT="local"
N8N_AI_WEBHOOK_URL="https://your-n8n-host/webhook/ai-assistant"
AI_API_KEY="your-model-provider-key"                # only if calling a model directly

# ---------- Object storage (OPTIONAL, for receipt images) ----------
STORAGE_BUCKET="receipts"
