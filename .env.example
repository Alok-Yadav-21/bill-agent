# ---------- Database (source of truth) ----------
# Use your Supabase project's Postgres connection string (Project Settings ->
# Database -> Connection string -> URI), or any Postgres.
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# ---------- Authentication (Supabase Auth) ----------
# Project Settings -> API. The anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key is server-only and must NEVER be exposed to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------- Demo household (temporary, until the household switcher lands) ----------
NEXT_PUBLIC_DEMO_HOUSEHOLD_ID=""

# ---------- Receipt processing (OPTIONAL) ----------
# Selects the implementation: anthropic | n8n | (add your own)
RECEIPT_PROCESSOR="anthropic"

# For RECEIPT_PROCESSOR="anthropic": create a key at console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override. Default is a fast, low-cost vision model.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# For RECEIPT_PROCESSOR="n8n" instead:
N8N_RECEIPT_WEBHOOK_URL="https://your-n8n-host/webhook/receipt-processing"
N8N_API_KEY="shared-secret-between-app-and-n8n"

# ---------- AI assistant (OPTIONAL) ----------
AI_ASSISTANT="local"
N8N_AI_WEBHOOK_URL="https://your-n8n-host/webhook/ai-assistant"
AI_API_KEY="your-model-provider-key"

# ---------- Object storage (OPTIONAL, for receipt images) ----------
STORAGE_BUCKET="receipts"
